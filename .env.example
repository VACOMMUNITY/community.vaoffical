# COMMUNITY.VA Environment Configuration Template
# To enable Supabase Cloud Database & OAuth redirect on Vercel:
# 1. Go to your Vercel Project Settings -> Environment Variables
# 2. Add the following keys:

# Supabase Project URL & Anon Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Authorized Admin Emails (comma separated)
VITE_ADMIN_EMAILS=community.va01@gmail.com,foundercommunityva@gmail.com
